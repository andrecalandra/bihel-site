{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/crm-insights",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "bihel-site.vercel.app" }],
      "destination": "https://www.bihel.com.br/$1",
      "permanent": true
    },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/sobre-nos", "destination": "/#sobre", "permanent": true },
    { "source": "/sobre", "destination": "/#sobre", "permanent": true },
    { "source": "/servico", "destination": "/#servicos", "permanent": true },
    { "source": "/servicos", "destination": "/#servicos", "permanent": true },
    { "source": "/servico/:path*", "destination": "/#servicos", "permanent": true },
    { "source": "/servicos/:path*", "destination": "/#servicos", "permanent": true },
    { "source": "/contato", "destination": "/#orcamento", "permanent": true },
    { "source": "/fale-conosco", "destination": "/#orcamento", "permanent": true },
    { "source": "/blog", "destination": "/", "permanent": true },
    { "source": "/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/feed", "destination": "/", "permanent": true },
    { "source": "/avaliacoes", "destination": "/#depoimentos", "permanent": true },
    { "source": "/avaliacoes/:path*", "destination": "/#depoimentos", "permanent": true },
    { "source": "/avaliacao/:path*", "destination": "/#depoimentos", "permanent": true },
    { "source": "/noticias", "destination": "/", "permanent": true },
    { "source": "/noticias/:path*", "destination": "/", "permanent": true },
    { "source": "/category/:path*", "destination": "/", "permanent": true },
    { "source": "/tag/:path*", "destination": "/", "permanent": true },
    { "source": "/author/:path*", "destination": "/", "permanent": true },
    { "source": "/page-sitemap.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/post-sitemap.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/sitemap_index.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/wp-sitemap.xml", "destination": "/sitemap.xml", "permanent": true }
  ]
}
