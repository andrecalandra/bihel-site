# Variáveis do painel de acessos (/painel). Na Vercel: Project → Settings → Environment Variables.
# Para rodar localmente NÃO é preciso nada: `npm run dev:api` usa memória e a senha "teste".

# Senha para entrar no painel (obrigatória em produção). Use algo longo.
DASHBOARD_PASSWORD=

# Banco Redis (Upstash). Ao conectar o Upstash Redis pela aba Storage/Marketplace da Vercel,
# estas variáveis (ou KV_REST_API_URL / KV_REST_API_TOKEN) são criadas automaticamente.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcionais
# ANALYTICS_SECRET=            # segredo extra para o hash diário do visitante (padrão: a senha)
# ANALYTICS_HOSTS=             # domínios que podem enviar dados (padrão: bihel-site.vercel.app, bihel.com.br, www.bihel.com.br)
